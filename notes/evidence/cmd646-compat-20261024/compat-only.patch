@@ -216,6 +256,14 @@
 
     for (i = 0; i < 2; i++) {
         ide_bus_reset(&d->bus[i]);
+    }
+    if (CMD646(d)->b134_status_compat) {
+        PCIDevice *pd = PCI_DEVICE(d);
+
+        CMD646(d)->live_irq = 0;
+        pd->config[MRDMODE] &= ~(MRDMODE_INTR_CH0 | MRDMODE_INTR_CH1);
+        cmd646_update_dma_interrupts(pd);
+        cmd646_update_irq(pd);
     }
 }
 
@@ -248,12 +296,27 @@
 }
 
 /* CMD646 PCI IDE controller */
+static bool cmd646_compat_init(CMD646State *s, Error **errp)
+{
+    if (!s->b134_status_compat) {
+        return true;
+    }
+    error_setg(&s->migration_blocker,
+               "cmd646-ide.x-b134-status-compat is experimental and "
+               "does not support migration or snapshots");
+    return migrate_add_blocker(&s->migration_blocker, errp) == 0;
+}
+
 static void pci_cmd646_ide_realize(PCIDevice *dev, Error **errp)
 {
     PCIIDEState *d = PCI_IDE(dev);
     DeviceState *ds = DEVICE(dev);
     uint8_t *pci_conf = dev->config;
     int i;
+
+    if (!cmd646_compat_init(CMD646(dev), errp)) {
+        return;
+    }
 
     pci_conf[PCI_CLASS_PROG] = 0x8f;
 
@@ -308,13 +371,40 @@
     PCIIDEState *d = PCI_IDE(dev);
     unsigned i;
 
+    migrate_del_blocker(&CMD646(dev)->migration_blocker);
+
     for (i = 0; i < 2; ++i) {
         memory_region_del_subregion(&d->bmdma_bar, &d->bmdma[i].extra_io);
         memory_region_del_subregion(&d->bmdma_bar, &d->bmdma[i].addr_ioport);
     }
 }
 
+/* Experimental IRQ history has no supported migration representation. */
+static int cmd646_pre_load(void *opaque)
+{
+    if (CMD646(opaque)->b134_status_compat) {
+        error_report("cmd646-ide.x-b134-status-compat does not support "
+                     "migration or snapshot restore");
+        return -EINVAL;
+    }
+    return vmstate_ide_pci.pre_load ? vmstate_ide_pci.pre_load(opaque) : 0;
+}
+
+static int cmd646_pre_save(void *opaque)
+{
+    if (CMD646(opaque)->b134_status_compat) {
+        error_report("cmd646-ide.x-b134-status-compat does not support "
+                     "migration or snapshots");
+        return -EINVAL;
+    }
+    return vmstate_ide_pci.pre_save ? vmstate_ide_pci.pre_save(opaque) : 0;
+}
+
+static VMStateDescription vmstate_cmd646;
+
 static Property cmd646_ide_properties[] = {
+    DEFINE_PROP_BOOL("x-b134-status-compat", CMD646State,
+                     b134_status_compat, false),
     DEFINE_PROP_UINT32("secondary", PCIIDEState, secondary, 0),
     DEFINE_PROP_END_OF_LIST(),
 };
