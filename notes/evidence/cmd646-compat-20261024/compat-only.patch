 /* CMD646 specific */
 #define CFR                  0x50
@@ -183,8 +196,18 @@
 
 static void cmd646_update_irq(PCIDevice *pd)
 {
+    CMD646State *s = CMD646(pd);
     int pci_level;
 
+    if (s->b134_status_compat) {
+        /* Experimental consumer compatibility: history is not output level. */
+        pci_level = ((s->live_irq & 1) &&
+                     !(pd->config[MRDMODE] & MRDMODE_BLK_CH0)) ||
+                    ((s->live_irq & 2) &&
+                     !(pd->config[MRDMODE] & MRDMODE_BLK_CH1));
+        pci_set_irq(pd, pci_level);
+        return;
+    }
     pci_level = ((pd->config[MRDMODE] & MRDMODE_INTR_CH0) &&
                  !(pd->config[MRDMODE] & MRDMODE_BLK_CH0)) ||
         ((pd->config[MRDMODE] & MRDMODE_INTR_CH1) &&
@@ -198,8 +221,25 @@
     PCIIDEState *d = opaque;
     PCIDevice *pd = PCI_DEVICE(d);
     int irq_mask;
+    CMD646State *s = CMD646(d);
 
     irq_mask = MRDMODE_INTR_CH0 << channel;
+    if (s->b134_status_compat) {
+        uint8_t live_mask = 1 << channel;
+
+        /* Acknowledgement while high does not manufacture another edge. */
+        if (level && !(s->live_irq & live_mask)) {
+            pd->config[MRDMODE] |= irq_mask;
+        }
+        if (level) {
+            s->live_irq |= live_mask;
+        } else {
+            s->live_irq &= ~live_mask;
+        }
+        cmd646_update_dma_interrupts(pd);
+        cmd646_update_irq(pd);
+        return;
+    }
     if (level) {
