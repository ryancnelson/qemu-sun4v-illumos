# A build is acceptable only when it attests this whole QEMU contract.
#
# The source archive is a pinned ec2trib export, not a pristine upstream
# archive: it already contains the large-SPARC-TTE range-flush change.  Its
# SHA-256 is therefore part of the identity; merely matching QEMU_COMMIT is
# insufficient.
QEMU_CONTRACT_ID=sparc-tlb-range-flush-v1
QEMU_SOURCE_COMMIT=049affb20df67162cf58deeaf74d5ad4b83cbdc3
QEMU_SOURCE_ARCHIVE_SHA256=4990dafc5ca24bb73837d5d5652aa8bf16bd6df5e9db54b873cfcc59d0fa9c95
QEMU_PATCHSET=source-tlb-range-flush,0004-strand-id,0005-interrupt-dump,0006-mondo-deferral
