#!/usr/bin/env bash

set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
IMAGE=${IMAGE:-sparc64-qemu-illumos-guest:local}
CONTAINER=${CONTAINER:-sparc64-qemu-illumos-guest}
SELF_IMAGE=${SELF_IMAGE:-sparc64-qemu-openindiana-20g:self-contained}
SELF_CONTAINER=${SELF_CONTAINER:-sparc64-qemu-openindiana-20g-selftest}
SELF_VOLUME=${SELF_VOLUME:-${SELF_CONTAINER}-state}
SELF_BUNDLE=${SELF_BUNDLE:-sparc64-qemu-openindiana-20g-beta-20260901.tar.zst}
SELF_ARCHIVE=${SELF_ARCHIVE:-$ROOT/release/sparc64-qemu-openindiana-20g-self-contained-oci.tar.zst}

die()
{
    echo "appliance: $*" >&2
    exit 1
}

require_assets()
{
    for file in \
        "$ROOT/assets/carrier-unit100.img" \
        "$ROOT/assets/installer-unit103.img" \
        "$ROOT/assets/${ROOT_IMAGE:-root-unit104.raw}" \
        "$ROOT/assets/nvram1" \
        "$ROOT/assets/firmware/q.bin"
    do
        [[ -e "$file" ]] || die "missing asset: $file"
    done
}

case "${1:-}" in
build)
    docker build --pull \
        --build-arg QEMU_COMMIT=049affb20df67162cf58deeaf74d5ad4b83cbdc3 \
        -t "$IMAGE" "$ROOT"
    ;;
self-build)
    [[ -r "$ROOT/release/$SELF_BUNDLE" ]] || \
        die "missing embedded bundle: $ROOT/release/$SELF_BUNDLE"
    docker image inspect "$IMAGE" >/dev/null 2>&1 || \
        die "base image is missing; run ./appliance build first"
    chan_source=${NIAGARA_CHAN_SOURCE:-$ROOT/host-tools}
    if [[ ! -d "$chan_source" ]]; then
        chan_source="$ROOT/../../tools/chan"
    fi
    [[ -r "$chan_source/chan.h" ]] || \
        die "missing channel helper source: $chan_source/chan.h"
    context="$ROOT/state/self-contained-context"
    rm -rf "$context"
    mkdir -p "$context/embedded" "$context/scripts" "$context/host-tools"
    cp -p "$ROOT/Dockerfile.self-contained" "$context/Dockerfile"
    cp -p "$ROOT/assets.release.SHA256SUMS" "$context/"
    cp -a "$ROOT/assets/firmware" "$context/firmware"
    (cd "$ROOT/assets/firmware" && \
        find . -type f -print0 | sort -z | xargs -0 sha256sum) \
        >"$context/firmware.SHA256SUMS"
    cp -p \
        "$ROOT/scripts/container-entrypoint.sh" \
        "$ROOT/scripts/container-network.sh" \
        "$ROOT/scripts/smoke-login.py" \
        "$ROOT/scripts/guest-command.py" \
        "$context/scripts/"
    cp -p \
        "$chan_source/chan.h" \
        "$chan_source/host-chan.py" \
        "$chan_source/host-pppd-once.sh" \
        "$chan_source/host-bbs.py" \
        "$chan_source/isp_client.py" \
        "$chan_source/isp_protocol.py" \
        "$context/host-tools/"
    ln "$ROOT/release/$SELF_BUNDLE" "$context/embedded/$SELF_BUNDLE"
    docker build \
        --build-arg "BASE_IMAGE=$IMAGE" \
        -t "$SELF_IMAGE" "$context"
    rm -rf "$context"
    ;;
verify-assets)
    require_assets
    (cd "$ROOT/assets" && sha256sum -c "$ROOT/assets.SHA256SUMS")
    ;;
verify20)
    ROOT_IMAGE=root-unit105-20g.raw require_assets
    (cd "$ROOT/assets" && sha256sum -c "$ROOT/assets.release.SHA256SUMS")
    ;;
up)
    require_assets
    mkdir -p "$ROOT/state"
    if docker container inspect "$CONTAINER" >/dev/null 2>&1; then
        die "container already exists; use ./appliance stop first"
    fi
    docker run -d \
        --name "$CONTAINER" \
        --hostname oi-basecamp \
        --memory 6g \
        --cpus 2 \
        --tmpfs /run/unit100:rw,size=1200m,mode=0700 \
        -e "ROOT_IMAGE=${ROOT_IMAGE:-root-unit104.raw}" \
        -e "ROOT_BYTES=${ROOT_BYTES:-64424509440}" \
        -e "ROOT_UNIT=${ROOT_UNIT:-104}" \
        -e "ATTACH_MIGRATION_TARGET=${ATTACH_MIGRATION_TARGET:-0}" \
        --mount "type=bind,src=$ROOT/assets,dst=/assets" \
        --mount "type=bind,src=$ROOT/state,dst=/state" \
        "$IMAGE"
    ;;
smoke)
    "$0" up
    cd "$ROOT"
    CONSOLE_SOCKET="$ROOT/state/console.sock" \
        python3 scripts/smoke-login.py | tee state/smoke-login.out
    ;;
smoke20)
    ROOT_IMAGE=root-unit105-20g.raw \
        ROOT_BYTES=21474836480 \
        ROOT_UNIT=105 \
        ATTACH_MIGRATION_TARGET=0 \
        "$0" up
    cd "$ROOT"
    CONSOLE_SOCKET="$ROOT/state/console.sock" \
        OPENBOOT_COMMAND="boot /virtual-devices@100/disk@5:a -k -v" \
        python3 scripts/smoke-login.py | tee state/smoke20-login.out
    ;;
self-up)
    mkdir -p "$ROOT/state/self-contained"
    if docker container inspect "$SELF_CONTAINER" >/dev/null 2>&1; then
        die "self-contained test container already exists; use self-stop"
    fi
    if docker volume inspect "$SELF_VOLUME" >/dev/null 2>&1; then
        die "self-contained test volume already exists; use self-stop"
    fi
    docker volume create \
        --label io.niagara.appliance-ci=1 \
        "$SELF_VOLUME" >/dev/null
    docker run -d \
        --name "$SELF_CONTAINER" \
        --hostname oi-basecamp \
        --memory 6g \
        --cpus 2 \
        --cap-add NET_ADMIN \
        --device /dev/ppp \
        --sysctl net.ipv4.ip_forward=1 \
        --tmpfs /run/unit100:rw,size=1200m,mode=0700 \
        --mount "type=volume,src=$SELF_VOLUME,dst=/var/lib/illumos-appliance" \
        -e NIAGARA_NETWORK=required \
        "$SELF_IMAGE"
    ;;
self-smoke)
    "$0" self-up
    docker exec \
        -e CONSOLE_SOCKET=/state/console.sock \
        -e EVIDENCE_PATH=/state/self-smoke-console.log \
        -e OPENBOOT_COMMAND="boot /virtual-devices@100/disk@5:a -k -v" \
        "$SELF_CONTAINER" \
        python3 /usr/local/bin/appliance-smoke-login | \
        tee "$ROOT/state/self-contained/smoke-login.out"
    ;;
self-inventory)
    docker exec "$SELF_CONTAINER" \
        python3 /usr/local/bin/appliance-guest-command \
        --socket /state/console.sock \
        --timeout 300 \
        --transcript /state/self-inventory-console.log \
        --command 'uname -a; zpool status distpool; zpool list distpool; zfs list -r distpool; df -h /; id jack; id ryan || true'
    ;;
self-network)
    guest_command=(python3 /usr/local/bin/appliance-guest-command \
        --socket /state/console.sock --timeout 180)
    docker exec "$SELF_CONTAINER" sh -c \
        'for n in $(seq 1 60); do grep -F "NETWORK_HELPERS=PASS" /state/network-helper.log >/dev/null 2>&1 && exit 0; sleep 1; done; cat /state/network-helper.log; exit 1'
    docker exec "$SELF_CONTAINER" "${guest_command[@]}" \
        --transcript /state/self-network-guest-start.log \
        --command '/usr/sbin/devfsadm -i sppp -i sppptun; NIAG_CHAN_DEV=/dev/rdsk/c1d0s2; export NIAG_CHAN_DEV; nohup /opt/niag/bin/guest-chand 0 /tmp/niag0 </dev/null >/tmp/niag-chand0.log 2>&1 & nohup /opt/niag/bin/guest-chand 1 /tmp/niag1 </dev/null >/tmp/niag-chand1.log 2>&1 & echo GUEST_CHANNELS_STARTED'
    docker exec "$SELF_CONTAINER" "${guest_command[@]}" \
        --transcript /state/self-network-bbs.log \
        --command '(echo ATDT18005551212; sleep 2; echo HELP; sleep 1; echo BYE) | /opt/niag/bin/socat - UNIX-CONNECT:/tmp/niag1 | grep "CONNECT 2400"'
    docker exec "$SELF_CONTAINER" "${guest_command[@]}" \
        --transcript /state/self-network-ppp-start.log \
        --command 'nohup /usr/bin/perl /opt/niag/bin/guest-ppp-chan.pl 0 10.0.5.15:10.0.5.1 </dev/null >/tmp/gppp0.log 2>&1 & echo GUEST_PPP_STARTED'
    docker exec "$SELF_CONTAINER" sh -c \
        'for n in $(seq 1 120); do ip -4 addr show ppp0 2>/dev/null | grep -F "10.0.5.1 peer 10.0.5.15" >/dev/null && exit 0; sleep 1; done; cat /state/network/ppp.log; exit 1'
    docker exec "$SELF_CONTAINER" sh -c \
        'for n in $(seq 1 30); do grep -F "phase=ready" /state/network/status.env >/dev/null 2>&1 && exit 0; sleep 1; done; cat /state/network-helper.log; exit 1'
    docker exec "$SELF_CONTAINER" ping -c 2 -W 5 10.0.5.15
    docker exec "$SELF_CONTAINER" "${guest_command[@]}" \
        --transcript /state/self-network-host-ping.log \
        --command '/usr/sbin/ping 10.0.5.1'
    docker exec "$SELF_CONTAINER" "${guest_command[@]}" \
        --transcript /state/self-network-nat-ping.log \
        --command '/usr/sbin/ping 8.8.8.8'
    docker exec "$SELF_CONTAINER" "${guest_command[@]}" \
        --transcript /state/self-network-dns.log \
        --command '/usr/bin/dig +short @10.0.5.1 example.com | /usr/bin/grep -E "^[0-9]+\\."'
    docker exec "$SELF_CONTAINER" "${guest_command[@]}" \
        --transcript /state/self-network-proxy.log \
        --command '(printf "CONNECT example.com:443 HTTP/1.0\r\n\r\n"; sleep 1) | /opt/niag/bin/socat - TCP:10.0.5.1:8888 | /usr/bin/grep "200 Connection established"'
    docker exec "$SELF_CONTAINER" sh -c \
        'wan=$(ip -4 route show default | awk "NR == 1 { print \$5 }"); iptables -t nat -C POSTROUTING -s 10.0.5.15/32 -o "$wan" -j MASQUERADE'
    docker exec "$SELF_CONTAINER" /usr/local/sbin/illumos-appliance-network health
    docker exec "$SELF_CONTAINER" sh -c \
        'grep -F "phase=ready" /state/network/status.env && ss -lntu | grep -F "10.0.5.1:53" && ss -lnt | grep -F "10.0.5.1:8888"'
    echo "OCI_GUEST_PPP_NAT=PASS host=10.0.5.1 guest=10.0.5.15"
    echo "OCI_GUEST_SERVICES=PASS dns=10.0.5.1:53 http_proxy=http://10.0.5.1:8888"
    ;;
self-inspect)
    docker inspect --format '{{json .Mounts}}' "$SELF_CONTAINER"
    docker exec "$SELF_CONTAINER" \
        sh -c 'stat -c "root_apparent_bytes=%s root_allocated_blocks=%b block_bytes=%B" /var/lib/illumos-appliance/assets/root-unit105-20g.raw; du -h /var/lib/illumos-appliance/assets/root-unit105-20g.raw; cat /var/lib/illumos-appliance/materialized-v1.manifest; cat /state/runtime-manifest.txt'
    ;;
self-evidence)
    evidence="$ROOT/state/self-contained/container-state"
    rm -rf "$evidence"
    mkdir -p "$evidence"
    for file in \
        materialized-v1.manifest \
        runtime-manifest.txt \
        console.log \
        self-smoke-console.log \
        self-inventory-console.log \
        self-network-guest-start.log \
        self-network-bbs.log \
        self-network-ppp-start.log \
        self-network-host-ping.log \
        self-network-nat-ping.log \
        self-network-dns.log \
        self-network-proxy.log \
        network-helper.log \
        qemu-debug.log
    do
        if [[ "$file" = materialized-v1.manifest ]]; then
            docker cp "$SELF_CONTAINER:/var/lib/illumos-appliance/$file" \
                "$evidence/$file" >/dev/null 2>&1 || true
        else
            docker cp "$SELF_CONTAINER:/state/$file" \
                "$evidence/$file" >/dev/null 2>&1 || true
        fi
    done
    docker cp "$SELF_CONTAINER:/state/network" "$evidence/network" \
        >/dev/null 2>&1 || true
    ;;
self-export)
    mkdir -p "$ROOT/release"
    docker save "$SELF_IMAGE" | zstd -T0 -10 -f -o "$SELF_ARCHIVE"
    sha256sum "$SELF_ARCHIVE"
    ;;
self-load)
    [[ -r "$SELF_ARCHIVE" ]] || die "missing OCI archive: $SELF_ARCHIVE"
    zstd -dc "$SELF_ARCHIVE" | docker load
    ;;
self-status)
    docker ps -a --filter "name=^/${SELF_CONTAINER}$"
    docker image ls "$SELF_IMAGE"
    ;;
self-stop)
    docker stop -t 30 "$SELF_CONTAINER" >/dev/null 2>&1 || true
    docker rm -v "$SELF_CONTAINER" >/dev/null 2>&1 || true
    docker volume rm "$SELF_VOLUME" >/dev/null 2>&1 || true
    ;;
console)
    exec docker exec -it "$CONTAINER" \
        socat UNIX-CONNECT:/state/console.sock STDIO,raw,echo=0
    ;;
logs)
    exec tail -f "$ROOT/state/console.log"
    ;;
status)
    docker ps -a --filter "name=^/${CONTAINER}$"
    ;;
stop)
    docker stop -t 30 "$CONTAINER" >/dev/null 2>&1 || true
    docker rm "$CONTAINER" >/dev/null 2>&1 || true
    ;;
*)
    echo "usage: $0 build|self-build|verify-assets|verify20|up|smoke|smoke20|self-up|self-smoke|self-network|self-inventory|self-inspect|self-evidence|self-export|self-load|self-status|self-stop|console|logs|status|stop" >&2
    exit 2
    ;;
esac
