#!/usr/bin/expect -f
# PPP install, part 2: satisfy pppd's last dependency and attach the driver.
#
# Part 1 (tools/provision-ppp.exp) unpacked the packages and found:
#   - sppp/sppptun ARE in /etc/name_to_major (186/187) but /dev/sppp is absent,
#     because add_drv reported "already installed" and never attached anything.
#   - pppd dies with: ld.so.1: pppd: fatal: libmd.so.1: open failed
#     libmd is absent from this 3/05 image; the media is a LATER Solaris 10
#     update, which is why its pppd wants it. Verified host-side that pppd needs
#     only SUNW_1.22 (under our SUNW_1.22.1 ceiling) and that libmd itself needs
#     nothing but libc, so shipping just that one library is safe. Installing all
#     of SUNWcsl would overwrite core libraries with later-update versions.
#
# Still does NOT start a link: the only real tty is /dev/console (qcn), because
# /dev/term/a is a DANGLING symlink to
#   ../../devices/pci@7c0/pci@0/pci@2/pci@0,2/isa@2/serial@0,3f8:a
# i.e. the real T2000's ISA-under-PCI serial port, which this machine has no bus
# for. Handing the console to PPP risks locking us out before `init 5`, so that
# gets its own session behind a ZFS snapshot.

fconfigure stdout -buffering none
set QEMU /home/ryan/devel/niagra-qemu-solaris-project/qemu/build/qemu-system-sparc64
set ZDEV /dev/zvol/datapool/niagara/vms/primary

proc cmd {c {t 20}} {
    if {[string length $c] > 200} { puts "\n>>> RESULT: LINE_TOO_LONG\n"; exit 2 }
    send "$c\r"
    expect {
        -timeout $t "# " {}
        timeout { puts "\n>>> RESULT: NO_PROMPT after ${t}s on: $c\n"; exit 1 }
    }
}

spawn $QEMU -M niagara -L /datapool/niagara/base-1gib -m 1024 -nographic \
    -drive if=pflash,file=$ZDEV,format=raw
set qpid [exp_pid]

expect { -timeout 90 "ok" {} timeout { puts "\n>>> RESULT: NO_OBP\n"; exit 1 } }
send "boot disk\r"
expect {
    -timeout 200 "login:" { puts "\n>>> BOOTED\n" }
    "BAD TRAP" { puts "\n>>> RESULT: PANICKED\n"; exit 1 }
    timeout    { puts "\n>>> RESULT: BOOT_TIMEOUT\n"; exit 1 }
}
send "root\r"
expect { -timeout 30 "# " {} timeout { puts "\n>>> RESULT: NO_LOGIN\n"; exit 1 } }

puts "\n>>> STEP 1: install libmd.so.1\n"
cmd "mkdir -p /x"
cmd "mount -F pcfs /dev/dsk/c0t0d0s3:c /x 2>&1" 60
cmd "cd / && tar xf /x/libmd.tar 2>&1" 60
cmd "ls -l /lib/libmd.so.1 /lib/sparcv9/libmd.so.1" 30

puts "\n>>> STEP 2: does pppd run now?\n"
cmd "/usr/bin/pppd --version 2>&1 | head -4" 40

puts "\n>>> STEP 3: attach the sppp driver so /dev/sppp exists\n"
cmd "devfsadm -i sppp 2>&1" 120
cmd "ls -l /dev/sppp 2>&1" 30
cmd "modinfo | grep -i sppp 2>&1" 40

puts "\n>>> STEP 4: what will PPP have to run over?\n"
cmd "ls -lL /dev/term/a 2>&1" 30
cmd "svcs -a 2>&1 | grep -i telnet" 40

puts "\n>>> STEP 5: unmount and halt cleanly\n"
cmd "cd / && umount /x 2>&1" 60
send "init 5\r"
expect {
    -timeout 180 -re "syncing file systems\\.\\.\\. done" { puts "\n>>> synced\n" }
    "Program terminated" { puts "\n>>> halted\n" }
    timeout { puts "\n>>> RESULT: HALT_NOT_OBSERVED\n"; exit 1 }
}
sleep 2
exec kill -TERM $qpid
expect {
    -timeout 240 "writeback complete" { puts "\n>>> RESULT: WRITEBACK_OK\n" }
    eof     { puts "\n>>> RESULT: EXITED_NO_WRITEBACK\n" }
    timeout { puts "\n>>> RESULT: WRITEBACK_TIMEOUT\n" }
}
catch { expect eof }
puts "\n>>> RESULT: DONE\n"
