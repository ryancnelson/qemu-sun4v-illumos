#!/usr/bin/expect -f
# Provision the guest toolchain in ONE boot, then shut down cleanly.
#
# Discipline enforced here, each learned from a failure this session:
#   * fconfigure -buffering none  -- Tcl buffers puts when stdout is a pipe, so
#     progress markers would otherwise appear only at exit.
#   * every line under 200 bytes  -- the Solaris console canonical input buffer
#     truncates past 256 AND drops the carriage return, so the command never
#     runs and the session looks hung. Hence `cd` + short relative paths.
#   * cmd aborts on a missing prompt -- marching through ten dead commands at
#     20s each is how a permanent failure masqueraded as a 300s "hang".
#   * init 5 then SIGTERM the qemu pid -- Ctrl-A c does not reach QEMU from a
#     scripted expect, and killing a guest at a shell prompt persists a dirty
#     LUFS journal, which panics the NEXT boot in ufs:readlog/vfs_mountroot.

fconfigure stdout -buffering none
set BLK  35960
set GCCP /opt/csw/gcc4/lib/gcc/sparc-sun-solaris2.8/4.3.3
set BINU /opt/csw/sparc-sun-solaris2.9/bin

proc cmd {c {t 20}} {
    if {[string length $c] > 200} {
        puts "\n>>> RESULT: LINE_TOO_LONG ([string length $c]B): $c\n"; exit 2
    }
    send "$c\r"
    expect {
        -timeout $t "# " {}
        timeout { puts "\n>>> RESULT: NO_PROMPT after ${t}s on: $c\n"; exit 1 }
    }
}

spawn /home/ryan/devel/niagra-qemu-solaris-project/qemu/build/qemu-system-sparc64 \
    -M niagara -L /datapool/niagara/base-1gib -m 1024 -nographic \
    -drive if=pflash,file=/dev/zvol/datapool/niagara/vms/primary,format=raw
set qpid [exp_pid]

expect { -timeout 90 "ok" {} timeout { puts "\n>>> RESULT: NO_OBP\n"; exit 1 } }
send "boot disk\r"
expect {
    -timeout 200 "login:" { puts "\n>>> BOOTED clean at 1GiB\n" }
    "BAD TRAP" { puts "\n>>> RESULT: PANICKED (dirty journal?)\n"; exit 1 }
    timeout    { puts "\n>>> RESULT: BOOT_TIMEOUT\n"; exit 1 }
}
send "root\r"
expect { -timeout 30 "# " {} timeout { puts "\n>>> RESULT: NO_LOGIN\n"; exit 1 } }

puts "\n>>> STEP 1: unpack headers + crt objects + libm headers\n"
cmd "cd /"
cmd "dd if=/dev/rdsk/c0t0d0s3 bs=512 count=$BLK 2>/dev/null | tar xf -" 300
cmd "ls /usr/include/stdio.h /usr/include/math.h" 30
cmd "ls /usr/lib/crti.o /usr/lib/values-Xa.o" 30
cmd "ls /usr/include/iso/math_c99.h /usr/include/sys/ieeefp.h" 30

puts "\n>>> STEP 2: make as/ld discoverable by plain gcc\n"
# gcc is sparc-sun-solaris2.8; binutils live under solaris2.9. gcc searches its
# own private exec dir first, so a symlink there fixes every invocation without
# -B and without touching PATH.
cmd "cd $GCCP"
cmd "rm -f as ld"
cmd "ln -s $BINU/as as"
cmd "ln -s $BINU/ld ld"
cmd "ls -l as ld" 30

puts "\n>>> STEP 3: prove plain gcc now compiles, links and RUNS\n"
cmd "cd /var/tmp"
cmd "rm -f tc.c tc"
cmd "echo '#include <stdio.h>' > tc.c"
cmd "echo '#include <math.h>' >> tc.c"
cmd "echo 'int main(void){' >> tc.c"
cmd "echo 'int s=0,i; for(i=1;i<=100;i++) s+=i;' >> tc.c"
cmd "echo 'printf(\"SUM=%d RC=%.5f\", s, sqrt(2.0));' >> tc.c"
cmd "echo 'putchar(10); return 0; }' >> tc.c"
cmd "/opt/csw/gcc4/bin/gcc -O2 -o tc tc.c -lm 2>&1" 180
cmd "./tc" 30
cmd "/usr/bin/file tc 2>&1" 30

puts "\n>>> STEP 4: clean shutdown (init 5, NOT a kill at the shell prompt)\n"
send "init 5\r"
expect {
    -timeout 180 -re "syncing file systems\\.\\.\\. done" { puts "\n>>> guest synced\n" }
    "Program terminated" { puts "\n>>> guest halted\n" }
    timeout { puts "\n>>> RESULT: HALT_NOT_OBSERVED\n"; exit 1 }
}
sleep 2
exec kill -TERM $qpid
expect {
    -timeout 240 "writeback complete" { puts "\n>>> RESULT: WRITEBACK_OK\n" }
    eof     { puts "\n>>> RESULT: EXITED_NO_WRITEBACK_LINE\n" }
    timeout { puts "\n>>> RESULT: WRITEBACK_TIMEOUT\n" }
}
catch { expect eof }
puts "\n>>> RESULT: DONE\n"
