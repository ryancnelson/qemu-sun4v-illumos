#!/usr/bin/expect -f
# Boot, hand off to the guest-side probe script, and wait. Expect never touches
# the tty after pppd starts -- the script handles its own recovery and shutdown.
fconfigure stdout -buffering none
set QEMU /home/ryan/devel/niagra-qemu-solaris-project/qemu/build/qemu-system-sparc64
spawn $QEMU -M niagara -L /datapool/niagara/base-1gib -m 1024 -nographic \
    -drive if=pflash,file=/dev/zvol/datapool/niagara/vms/primary,format=raw
set qpid [exp_pid]
expect { -timeout 90 "ok" {} timeout { puts "\n>>> RESULT: NO_OBP\n"; exit 1 } }
send "boot disk\r"
expect {
    -timeout 200 "login:" { puts "\n>>> BOOTED\n" }
    "BAD TRAP" { puts "\n>>> RESULT: PANICKED\n"; exit 1 }
    timeout { puts "\n>>> RESULT: BOOT_TIMEOUT\n"; exit 1 }
}
send "root\r"
expect { -timeout 30 "# " {} timeout { puts "\n>>> RESULT: NO_LOGIN\n"; exit 1 } }
send "mkdir -p /x && mount -F pcfs /dev/dsk/c0t0d0s3:c /x\r"
expect { -timeout 60 "# " {} timeout { puts "\n>>> RESULT: NO_MOUNT\n"; exit 1 } }
send "cp /x/PPPPROBE.SH /tmp/p.sh && chmod +x /tmp/p.sh\r"
expect { -timeout 60 "# " {} timeout { puts "\n>>> RESULT: NO_COPY\n"; exit 1 } }
puts "\n>>> handing off to the guest script (it will init 5 itself)\n"
send "sh /tmp/p.sh\r"
# From here the console may fill with PPP framing garbage. Just wait for halt.
expect {
    -timeout 400 -re "syncing file systems\\.\\.\\. done" { puts "\n>>> synced\n" }
    "Program terminated" { puts "\n>>> halted\n" }
    timeout { puts "\n>>> RESULT: SCRIPT_DID_NOT_HALT\n" }
}
sleep 3
exec kill -TERM $qpid
expect {
    -timeout 240 "writeback complete" { puts "\n>>> RESULT: WRITEBACK_OK\n" }
    eof { puts "\n>>> RESULT: EXITED\n" }
    timeout { puts "\n>>> RESULT: WRITEBACK_TIMEOUT\n" }
}
catch { expect eof }
puts "\n>>> RESULT: DONE\n"
