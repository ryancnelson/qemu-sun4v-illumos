#!/usr/bin/expect -f
# Can pppd carry a link over /dev/console (the qcn virtual console)?
#
# This is the pivotal question for P2-002. /dev/term/a is a dangling symlink to
# the real T2000's ISA-under-PCI serial port, so /dev/console is the ONLY tty in
# the machine. If pppd cannot drive it, PPP-over-console is dead and P2-008 (a
# second QEMU-serviced UART bound by the existing `su` driver) becomes the path.
#
# SAFE BY CONSTRUCTION. Handing the console to PPP could lock us out before
# `init 5`, and a kill at a shell prompt persists a dirty LUFS journal that
# panics the next boot. So each attempt is wrapped in a watchdog that pkills
# pppd after 20s, and pppd's own output is redirected to a FILE rather than the
# console we are borrowing. The console always comes back on its own.
# Backstop: primary@ppp-installed.

fconfigure stdout -buffering none
set QEMU /home/ryan/devel/niagra-qemu-solaris-project/qemu/build/qemu-system-sparc64
set ZDEV /dev/zvol/datapool/niagara/vms/primary

proc cmd {c {t 20}} {
    if {[string length $c] > 200} { puts "\n>>> RESULT: LINE_TOO_LONG\n"; exit 2 }
    send "$c\r"
    expect {
        -timeout $t "# " {}
        timeout { puts "\n>>> RESULT: NO_PROMPT after ${t}s on: $c\n"; exit 1 }
    }
}

spawn $QEMU -M niagara -L /datapool/niagara/base-1gib -m 1024 -nographic \
    -drive if=pflash,file=$ZDEV,format=raw
set qpid [exp_pid]

expect { -timeout 90 "ok" {} timeout { puts "\n>>> RESULT: NO_OBP\n"; exit 1 } }
send "boot disk\r"
expect {
    -timeout 200 "login:" { puts "\n>>> BOOTED\n" }
    "BAD TRAP" { puts "\n>>> RESULT: PANICKED\n"; exit 1 }
    timeout    { puts "\n>>> RESULT: BOOT_TIMEOUT\n"; exit 1 }
}
send "root\r"
expect { -timeout 30 "# " {} timeout { puts "\n>>> RESULT: NO_LOGIN\n"; exit 1 } }
cmd "PATH=/usr/bin:/usr/sbin:/sbin; export PATH"

puts "\n>>> ATTEMPT A: pppd with /dev/console named explicitly\n"
cmd "rm -f /tmp/a.log /tmp/b.log"
cmd "nohup sh -c 'sleep 20; pkill pppd' >/dev/null 2>&1 &"
# This borrows the console for up to 20s; the watchdog returns it.
send "pppd /dev/console 115200 noauth local passive debug nodetach >/tmp/a.log 2>&1\r"
expect {
    -timeout 90 "# " { puts "\n>>> console returned\n" }
    timeout { puts "\n>>> RESULT: CONSOLE_NOT_RETURNED\n"; exit 1 }
}
cmd "stty sane 2>/dev/null; echo BACK" 30
cmd "cat /tmp/a.log 2>&1 | head -20" 40

puts "\n>>> ATTEMPT B: pppd on its controlling tty (no device argument)\n"
cmd "nohup sh -c 'sleep 20; pkill pppd' >/dev/null 2>&1 &"
send "pppd 115200 noauth local passive debug nodetach >/tmp/b.log 2>&1\r"
expect {
    -timeout 90 "# " { puts "\n>>> console returned\n" }
    timeout { puts "\n>>> RESULT: CONSOLE_NOT_RETURNED_B\n"; exit 1 }
}
cmd "stty sane 2>/dev/null; echo BACK" 30
cmd "cat /tmp/b.log 2>&1 | head -20" 40

puts "\n>>> did an interface ever appear?\n"
cmd "ifconfig -a 2>&1 | head -12" 40

puts "\n>>> STEP: halt cleanly\n"
send "init 5\r"
expect {
    -timeout 180 -re "syncing file systems\\.\\.\\. done" { puts "\n>>> synced\n" }
    "Program terminated" { puts "\n>>> halted\n" }
    timeout { puts "\n>>> RESULT: HALT_NOT_OBSERVED\n"; exit 1 }
}
sleep 2
exec kill -TERM $qpid
expect {
    -timeout 240 "writeback complete" { puts "\n>>> RESULT: WRITEBACK_OK\n" }
    eof     { puts "\n>>> RESULT: EXITED_NO_WRITEBACK\n" }
    timeout { puts "\n>>> RESULT: WRITEBACK_TIMEOUT\n" }
}
catch { expect eof }
puts "\n>>> RESULT: DONE\n"
