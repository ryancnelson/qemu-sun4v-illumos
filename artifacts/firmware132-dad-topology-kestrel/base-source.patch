diff --git a/arch/sparc64/tree.fs b/arch/sparc64/tree.fs
index f390f6c..cbb5008 100644
--- a/arch/sparc64/tree.fs
+++ b/arch/sparc64/tree.fs
@@ -15,6 +15,23 @@ include config.fs
   rot pocket tohexstr r> tmpstrcat drop
 ;
 
+\ QEMU's Sabre host bridge has physical register address 1fe,0, but its
+\ canonical Open Firmware unit address is derived from upa-portid 1f.
+\ OpenBIOS passes two-cell unit addresses on the stack as low high.
+: decode-unit-sabre ( str len -- low high )
+  decode-unit-upa
+  dup 1f = if
+    drop 1fe
+  then
+;
+
+: encode-unit-sabre ( low high -- str len )
+  dup 1fe = if
+    drop 1f
+  then
+  encode-unit-upa
+;
+
 \ ---------
 \ DMA words
 \ ---------
@@ -44,8 +61,8 @@ include config.fs
   2 encode-int " #size-cells" property
   " sun4u" encode-string " compatible" property
 
-  : encode-unit encode-unit-upa ;
-  : decode-unit decode-unit-upa ;
+  : encode-unit encode-unit-sabre ;
+  : decode-unit decode-unit-sabre ;
 
   : dma-sync  ( virt devaddr size -- )
     (dma-sync)
diff --git a/config/scripts/switch-arch b/config/scripts/switch-arch
index b5acc6c..0fd5261 100755
--- a/config/scripts/switch-arch
+++ b/config/scripts/switch-arch
@@ -38,7 +38,8 @@ longbits()
     if test "$cpu" = "sparc64" -o "$cpu" = "ia64" \
         -o "$cpu" = "amd64" -o "$cpu" = "x86_64" \
         -o "$cpu" = "powerpc64" -o "$cpu" = "ppc64" \
-        -o "$cpu" = "ppc64le" -o "$cpu" = "alpha" ; then
+        -o "$cpu" = "ppc64le" -o "$cpu" = "alpha" \
+        -o "$cpu" = "aarch64" -o "$cpu" = "riscv64" ; then
         echo 64
     else
         echo 32
diff --git a/drivers/ide.c b/drivers/ide.c
index 4cc572c..df3136b 100644
--- a/drivers/ide.c
+++ b/drivers/ide.c
@@ -1471,6 +1471,18 @@ int ob_ide_init(const char *path, uint32_t io_port0, uint32_t ctl_port0,
 			push_str("block");
 			fword("device-type");
 
+#ifdef CONFIG_SPARC64
+			/* Let Solaris preload its ATA disk driver via the PROM node. */
+			if (drive->type == ide_type_ata &&
+			    drive->media == ide_media_disk) {
+				int compatible_len;
+
+				get_property(dnode, "compatible", &compatible_len);
+				if (compatible_len == -1)
+					set_property(dnode, "compatible", "dad", sizeof("dad"));
+			}
+#endif
+
 			PUSH(pointer2cell(drive));
 			feval("value drive");
 
diff --git a/drivers/pci.c b/drivers/pci.c
index f30e427..a7a96ff 100644
--- a/drivers/pci.c
+++ b/drivers/pci.c
@@ -1065,6 +1065,10 @@ int ebus_config_cb(const pci_config_t *config)
     ucell virt;
     phys_addr_t io_phys_base = 0;
 
+    /* EBus children use the two-cell BAR offset and register address. */
+    feval(": encode-unit encode-unit-upa ;");
+    feval(": decode-unit decode-unit-upa ;");
+
     /* Serial */
     props[0] = 0x14;
     props[1] = 0x3f8;
