+static void ob_ide_sun4u_decodeunit(int *idx)
+{
+    PUSH(2);
+    fword("parse-nhex");
+}
+
+static void ob_ide_sun4u_encodeunit(int *idx)
+{
+    feval("swap pocket tohexstr \" ,\" pocket tmpstrcat >r "
+          "rot pocket tohexstr r> tmpstrcat drop");
+}
