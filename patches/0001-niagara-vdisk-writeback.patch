 typedef struct NiagaraBoardState {
     MemoryRegion hv_ram;
@@ -84,6 +85,78 @@ typedef struct NiagaraBoardState {
 #define NIAGARA_OBP_OFFSET  0x80000ULL
 #define PROM_SIZE_MAX       (4 * MiB)
 
+/* vdisk: disk content loaded via reset handler, written back via atexit.
+ *
+ * At every machine reset, niagara_vdisk_load() reads the zvol directly into
+ * vdisk_ram in 64MB chunks — no ROM subsystem, no temp files, no INT_MAX
+ * overflow. VTOC slice-2 nblks (offset 0x1d0) is read to determine logical
+ * disk size; larger zvols work transparently.
+ *
+ * CRITICAL: run "lockfs -f / && sync" before exiting QEMU or the LUFS journal
+ * will be dirty and the next boot will panic at ufs:fetchbuf. */
+#define DISK_S2NBLK_OFFSET 0x1d0ULL
+
+static void   *niagara_vdisk_host;
+static size_t  niagara_vdisk_size;
+static char   *niagara_vdisk_path;
+
+static void niagara_vdisk_load(void *opaque)
+{
+    BlockBackend *blk = (BlockBackend *)opaque;
+    uint8_t *ptr = (uint8_t *)niagara_vdisk_host;
+    int64_t  size = (int64_t)niagara_vdisk_size;
+    const int64_t CHUNK = 64LL * 1024 * 1024;
+    int64_t off = 0;
+
+    if (!ptr || size <= 0) { return; }
+    memset(ptr, 0, size);
+    while (off < size) {
+        int64_t count = MIN(CHUNK, size - off);
+        blk_pread(blk, off, count, ptr + off, 0);
+        off += count;
+    }
+}
+
+static void niagara_vdisk_writeback(void)
+{
+    int fd;
+    int64_t off = 0, rem;
+    int r __attribute__((unused));
+    char cmd[512];
+
+    if (!niagara_vdisk_host || !niagara_vdisk_size || !niagara_vdisk_path)
+        return;
+
+    const char *zvol_prefix = "/dev/zvol/";
+    if (strncmp(niagara_vdisk_path, zvol_prefix, strlen(zvol_prefix)) == 0) {
+        const char *ds = niagara_vdisk_path + strlen(zvol_prefix);
+        snprintf(cmd, sizeof(cmd),
+                 "zfs snapshot '%s@pre-exit-%d' 2>/dev/null", ds, (int)getpid());
+        r = system(cmd);
+    }
+
+    fd = open(niagara_vdisk_path, O_WRONLY);
+    if (fd < 0) { perror("niagara: vdisk writeback open"); return; }
+
+    rem = (int64_t)niagara_vdisk_size;
+    while (rem > 0) {
+        size_t chunk = (size_t)MIN(rem, 64LL * 1024 * 1024);
+        ssize_t n = pwrite(fd, (const char *)niagara_vdisk_host + off, chunk, off);
+        if (n <= 0) {
+            fprintf(stderr, "niagara: vdisk writeback failed at offset %lld\n",
+                    (long long)off);
+            break;
+        }
+        off += n; rem -= n;
+    }
+    fdatasync(fd);
+    close(fd);
+    fprintf(stderr, "niagara: vdisk writeback complete (%lld MB)\n",
+            (long long)(off >> 20));
+    g_free(niagara_vdisk_path);
+    niagara_vdisk_path = NULL;
+}
+
 static void add_rom_or_fail(const char *file, const hwaddr addr)
 {
     /* XXX remove qtest_enabled() check once firmware files are
@@ -133,20 +206,40 @@ static void niagara_init(MachineState *machine)
     add_rom_or_fail("q.bin", NIAGARA_PROM_BASE + NIAGARA_Q_OFFSET);
     add_rom_or_fail("openboot.bin", NIAGARA_PROM_BASE + NIAGARA_OBP_OFFSET);
 
-    /* the virtual ramdisk is kind of initrd, but it resides
-       outside of the partition RAM */
     if (dinfo) {
         BlockBackend *blk = blk_by_legacy_dinfo(dinfo);
-        int size = blk_getlength(blk);
-        if (size > 0) {
-            memory_region_init_ram(&s->vdisk_ram, NULL, "sun4v_vdisk.ram", size,
-                                   &error_fatal);
+        int64_t zvol_size = blk_getlength(blk);
+        int64_t disk_size = 0;
+
+        if (zvol_size > 0) {
+            uint32_t nblks_be = 0;
+            if (blk_pread(blk, DISK_S2NBLK_OFFSET, sizeof(nblks_be),
+                          &nblks_be, 0) >= 0 && nblks_be != 0) {
+                uint32_t nblks = be32_to_cpu(nblks_be);
+                disk_size = (int64_t)nblks * 512;
+            }
+            /* blk_pread uses signed 32-bit count internally; cap below 2GB.
+             * 0x7FFFFE00 = largest 512-byte-aligned value below INT_MAX. */
+            disk_size = MIN(disk_size, (int64_t)0x7FFFFE00LL);
+            if (disk_size <= 0)
+                disk_size = MIN(zvol_size, (int64_t)512 * 1024 * 1024);
+        }
+
+        if (disk_size > 0) {
+            memory_region_init_ram(&s->vdisk_ram, NULL, "sun4v_vdisk.ram",
+                                   disk_size, &error_fatal);
             memory_region_add_subregion(get_system_memory(),
                                         NIAGARA_VDISK_BASE, &s->vdisk_ram);
             dinfo->is_default = 1;
-            rom_add_file_fixed(blk_bs(blk)->filename, NIAGARA_VDISK_BASE, -1);
+            niagara_vdisk_host = memory_region_get_ram_ptr(&s->vdisk_ram);
+            niagara_vdisk_size = (size_t)disk_size;
+            niagara_vdisk_path = g_strdup(blk_bs(blk)->filename);
+            qemu_register_reset(niagara_vdisk_load, blk);
+            atexit(niagara_vdisk_writeback);
+            fprintf(stderr, "niagara: vdisk %lld MB (zvol %lld MB)\n",
+                    (long long)(disk_size >> 20), (long long)(zvol_size >> 20));
         } else {
-            error_report("could not load ram disk '%s'",
+            error_report("niagara: cannot determine disk size for '%s'",
                          blk_bs(blk)->filename);
             exit(1);
         }
