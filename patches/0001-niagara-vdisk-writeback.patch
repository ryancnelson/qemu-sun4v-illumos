index ab3c4ec..75d8a0a 100644
--- a/hw/sparc64/niagara.c
+++ b/hw/sparc64/niagara.c
@@ -84,16 +84,41 @@ typedef struct NiagaraBoardState {
 #define NIAGARA_OBP_OFFSET  0x80000ULL
 #define PROM_SIZE_MAX       (4 * MiB)
 
+/* vdisk write-back: guest runtime writes go through q.bin LDC→SAM and
+ * evaporate. But boot-time writes (OBP reading kernel) DO reach vdisk_ram.
+ * atexit captures whatever landed in vdisk_ram on clean QEMU exit.
+ * NOTE: adding any additional RAM region to the guest physical address space
+ * causes a deterministic kernel panic in ufs:fetchbuf during vfs_mountroot.
+ * Root cause unknown — likely QEMU TCG TLB staling when mmap moves. See
+ * BACKLOG P1-004. Do not add memory regions here until that is resolved. */
+static void   *niagara_vdisk_host;
+static size_t  niagara_vdisk_size;
+static char   *niagara_vdisk_path;
+
+static void niagara_vdisk_writeback(void)
+{
+    int fd;
+    ssize_t n;
+    if (!niagara_vdisk_host || !niagara_vdisk_size || !niagara_vdisk_path)
+        return;
+    fd = open(niagara_vdisk_path, O_WRONLY);
+    if (fd < 0) { perror("niagara: vdisk writeback"); return; }
+    n = pwrite(fd, niagara_vdisk_host, niagara_vdisk_size, 0);
+    if (n != (ssize_t)niagara_vdisk_size)
+        fprintf(stderr, "niagara: vdisk writeback: %zd of %zu bytes\n",
+                n, niagara_vdisk_size);
+    fdatasync(fd);
+    close(fd);
+    g_free(niagara_vdisk_path);
+    niagara_vdisk_path = NULL;
+}
+
 static void add_rom_or_fail(const char *file, const hwaddr addr)
 {
-    /* XXX remove qtest_enabled() check once firmware files are
-     * in the qemu tree
-     */
     if (!qtest_enabled() && rom_add_file_fixed(file, addr, -1)) {
         error_report("Unable to load a firmware for -M niagara");
         exit(1);
     }
-
 }
 /* Niagara hardware initialisation */
 static void niagara_init(MachineState *machine)
@@ -133,21 +158,26 @@ static void niagara_init(MachineState *machine)
     add_rom_or_fail("q.bin", NIAGARA_PROM_BASE + NIAGARA_Q_OFFSET);
     add_rom_or_fail("openboot.bin", NIAGARA_PROM_BASE + NIAGARA_OBP_OFFSET);
 
-    /* the virtual ramdisk is kind of initrd, but it resides
-       outside of the partition RAM */
+    /* vdisk: loaded into anonymous RAM via ROM loader.
+     * Writes from the guest go through q.bin LDC/SAM and do NOT reach
+     * this RAM — runtime writes are lost. Boot-time OBP reads do use this
+     * region directly. atexit captures RAM state on clean exit. */
     if (dinfo) {
         BlockBackend *blk = blk_by_legacy_dinfo(dinfo);
-        int size = blk_getlength(blk);
+        int64_t size = blk_getlength(blk);
         if (size > 0) {
-            memory_region_init_ram(&s->vdisk_ram, NULL, "sun4v_vdisk.ram", size,
-                                   &error_fatal);
+            memory_region_init_ram(&s->vdisk_ram, NULL, "sun4v_vdisk.ram",
+                                   size, &error_fatal);
             memory_region_add_subregion(get_system_memory(),
                                         NIAGARA_VDISK_BASE, &s->vdisk_ram);
             dinfo->is_default = 1;
             rom_add_file_fixed(blk_bs(blk)->filename, NIAGARA_VDISK_BASE, -1);
+            niagara_vdisk_host = memory_region_get_ram_ptr(&s->vdisk_ram);
+            niagara_vdisk_size = (size_t)size;
+            niagara_vdisk_path = g_strdup(blk_bs(blk)->filename);
+            atexit(niagara_vdisk_writeback);
         } else {
-            error_report("could not load ram disk '%s'",
-                         blk_bs(blk)->filename);
+            error_report("could not load disk '%s'", blk_bs(blk)->filename);
             exit(1);
         }
     }
