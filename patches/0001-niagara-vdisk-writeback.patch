diff --git a/hw/sparc64/niagara.c b/hw/sparc64/niagara.c
index ab3c4ec..3a9901f 100644
--- a/hw/sparc64/niagara.c
+++ b/hw/sparc64/niagara.c
@@ -84,6 +84,51 @@ typedef struct NiagaraBoardState {
 #define NIAGARA_OBP_OFFSET  0x80000ULL
 #define PROM_SIZE_MAX       (4 * MiB)
 
+/* vdisk write-back.
+ *
+ * Writes reach vdisk_ram via hcall_disk_write (0xf1) direct hypercall.
+ * Confirmed by /proc/pid/mem forensics and binary diff of zvol before/after.
+ *
+ * On every exit: snapshot @pre-exit-<pid> FIRST, then write vdisk_ram to
+ * the backing zvol. The snapshot is the rollback point if the write is bad.
+ * UFS logging (LUFS) handles crash recovery — the next boot replays the
+ * journal even from a post-panic writeback. */
+static void   *niagara_vdisk_host;
+static size_t  niagara_vdisk_size;
+static char   *niagara_vdisk_path;
+
+static void niagara_vdisk_writeback(void)
+{
+    int fd;
+    ssize_t n;
+    int r __attribute__((unused));
+    char cmd[512];
+
+    if (!niagara_vdisk_host || !niagara_vdisk_size || !niagara_vdisk_path)
+        return;
+
+    /* Snapshot before write — always have a rollback point */
+    const char *zvol_prefix = "/dev/zvol/";
+    if (strncmp(niagara_vdisk_path, zvol_prefix, strlen(zvol_prefix)) == 0) {
+        const char *ds = niagara_vdisk_path + strlen(zvol_prefix);
+        snprintf(cmd, sizeof(cmd),
+                 "zfs snapshot '%s@pre-exit-%d' 2>/dev/null", ds, (int)getpid());
+        r = system(cmd);
+    }
+
+    fd = open(niagara_vdisk_path, O_WRONLY);
+    if (fd < 0) { perror("niagara: vdisk writeback open"); return; }
+    n = pwrite(fd, niagara_vdisk_host, niagara_vdisk_size, 0);
+    if (n != (ssize_t)niagara_vdisk_size)
+        fprintf(stderr, "niagara: vdisk writeback: %zd of %zu bytes\n",
+                n, niagara_vdisk_size);
+    fdatasync(fd);
+    close(fd);
+    fprintf(stderr, "niagara: vdisk writeback complete\n");
+    g_free(niagara_vdisk_path);
+    niagara_vdisk_path = NULL;
+}
+
 static void add_rom_or_fail(const char *file, const hwaddr addr)
 {
     /* XXX remove qtest_enabled() check once firmware files are
@@ -133,21 +178,78 @@ static void niagara_init(MachineState *machine)
     add_rom_or_fail("q.bin", NIAGARA_PROM_BASE + NIAGARA_Q_OFFSET);
     add_rom_or_fail("openboot.bin", NIAGARA_PROM_BASE + NIAGARA_OBP_OFFSET);
 
-    /* the virtual ramdisk is kind of initrd, but it resides
-       outside of the partition RAM */
+    /* The vdisk is mapped into anonymous RAM so q.bin can serve disk I/O.
+     * vdisk_ram size is capped at the VTOC-specified disk size regardless of
+     * the backing zvol size. This lets the zvol grow freely (for additional
+     * partitions) while keeping vdisk_ram at a stable size that doesn't
+     * trigger the ufs:fetchbuf kernel panic seen with larger allocations.
+     *
+     * The VTOC slice-2 nblks field at offset DISK_S2NBLK_OFFSET (0x1d0) is
+     * read from the backing file to determine the logical disk size. */
+#define DISK_S2NBLK_OFFSET 0x1d0ULL
     if (dinfo) {
         BlockBackend *blk = blk_by_legacy_dinfo(dinfo);
-        int size = blk_getlength(blk);
-        if (size > 0) {
-            memory_region_init_ram(&s->vdisk_ram, NULL, "sun4v_vdisk.ram", size,
-                                   &error_fatal);
+        int64_t zvol_size = blk_getlength(blk);
+        int64_t disk_size = 0;
+
+        if (zvol_size > 0) {
+            /* Read VTOC slice-2 nblks (big-endian u32 at offset 0x1d0).
+             * Falls back to zvol_size if read fails or returns implausible value. */
+            uint32_t nblks_be = 0;
+            if (blk_pread(blk, DISK_S2NBLK_OFFSET, sizeof(nblks_be),
+                          &nblks_be, 0) == sizeof(nblks_be) && nblks_be != 0) {
+                uint32_t nblks = be32_to_cpu(nblks_be);
+                disk_size = (int64_t)nblks * 512;
+            }
+            if (disk_size <= 0 || disk_size > zvol_size) {
+                disk_size = MIN(zvol_size, (int64_t)512 * 1024 * 1024);
+            }
+        }
+
+        if (disk_size > 0) {
+            memory_region_init_ram(&s->vdisk_ram, NULL, "sun4v_vdisk.ram",
+                                   disk_size, &error_fatal);
             memory_region_add_subregion(get_system_memory(),
                                         NIAGARA_VDISK_BASE, &s->vdisk_ram);
             dinfo->is_default = 1;
-            rom_add_file_fixed(blk_bs(blk)->filename, NIAGARA_VDISK_BASE, -1);
+            /* Read exactly disk_size bytes into a temp buffer, then register
+             * as a ROM blob. rom_add_file_fixed reads the whole file (2GB for
+             * a grown zvol), corrupting memory past vdisk_ram. The blob approach
+             * caps the read, survives machine reset, and uses the same code path
+             * as the original 512MB case (rom_add_file_fixed on a temp file). */
+            {
+                void *buf = g_malloc(disk_size);
+                int64_t rd = blk_pread(blk, 0, disk_size, buf, 0);
+                if (rd < 0) {
+                    error_report("niagara: failed to read vdisk (rc=%lld)", (long long)rd);
+                    g_free(buf);
+                    exit(1);
+                }
+                /* Write to a temp file so rom_add_file_fixed reads exactly
+                 * disk_size bytes (not the full zvol). The temp file is
+                 * deleted immediately after registration. */
+                char tmpname[] = "/tmp/niagara-vdisk-XXXXXX";
+                int tmpfd = mkstemp(tmpname);
+                if (tmpfd < 0 ||
+                    write(tmpfd, buf, disk_size) != disk_size ||
+                    close(tmpfd) < 0) {
+                    error_report("niagara: failed to write vdisk temp file");
+                    unlink(tmpname);
+                    g_free(buf);
+                    exit(1);
+                }
+                g_free(buf);
+                rom_add_file_fixed(tmpname, NIAGARA_VDISK_BASE, -1);
+                unlink(tmpname);   /* ROM subsystem has its own copy */
+            }
+            niagara_vdisk_host = memory_region_get_ram_ptr(&s->vdisk_ram);
+            niagara_vdisk_size = (size_t)disk_size;
+            niagara_vdisk_path = g_strdup(blk_bs(blk)->filename);
+            atexit(niagara_vdisk_writeback);
+            fprintf(stderr, "niagara: vdisk %lld MB (zvol %lld MB, VTOC cap)\n",
+                    (long long)(disk_size >> 20), (long long)(zvol_size >> 20));
         } else {
-            error_report("could not load ram disk '%s'",
-                         blk_bs(blk)->filename);
+            error_report("could not load disk '%s'", blk_bs(blk)->filename);
             exit(1);
         }
     }
