+            niagara_vdisk_path = g_strdup(blk_bs(blk)->filename);
+            qemu_register_reset(niagara_vdisk_load, blk);
+            atexit(niagara_vdisk_writeback);
+            fprintf(stderr, "niagara: vdisk %lld MB (zvol %lld MB)\n",
+                    (long long)(disk_size >> 20), (long long)(zvol_size >> 20));
         } else {
-            error_report("could not load ram disk '%s'",
+            error_report("niagara: cannot determine disk size for '%s'",
                          blk_bs(blk)->filename);
             exit(1);
         }
