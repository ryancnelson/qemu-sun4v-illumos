+/* vdisk: a MAP_SHARED mapping of the image file (P2-012). No load, no writeback.
+ *
+ * The image must be a REGULAR FILE, not a zvol — block devices do not support
+ * MAP_SHARED writeback reliably. VTOC slice-2 nblks (offset 0x1d0) still gives
+ * the logical disk size, so a larger image works transparently.
+ *
+ * CRITICAL, and unchanged by P2-012: run "sync; lockfs -f /" in the guest before
+ * killing QEMU, or the LUFS journal is dirty and the next boot panics in
+ * ufs:fetchbuf. Durability is now automatic; CONSISTENCY still is not. */
+#define DISK_S2NBLK_OFFSET 0x1d0ULL
+
+static void   *niagara_vdisk_host;
+static size_t  niagara_vdisk_size;
+static char   *niagara_vdisk_path;
+
+/* P2-012: with MAP_SHARED there is no load, no writeback, and no copy of the
+ * disk anywhere. `niagara_vdisk_host` points straight into the page cache for
+ * the image file, so a guest store IS a dirty page the kernel will write back.
+ *
+ * Deleted along with the copies:
+ *   - niagara_vdisk_load()  - mmap faults pages in on demand instead
+ *   - niagara_vdisk_writeback_full() and its atexit hook
+ *   - niagara_vdisk_load_ok - it existed because a failed blk_pread would leave
+ *     memset zeros that the unconditional writeback then persisted over the real
+ *     disk, a self-reinforcing corruption loop. With no read and no write step,
+ *     that failure mode does not exist.
+ *   - the P2-014 channel flush/reload timer - host and guest now look at the
+ *     same pages, so there is nothing to shuttle.
+ *
+ * SIGUSR2 survives, with a smaller job: force a durability point.
+ *
+ * SIGUSR2 NOT SIGUSR1: QEMU defines SIG_IPI as SIGUSR1 on Linux and uses it to
+ * kick CPU threads, so a handler on SIGUSR1 is overwritten or the signal is
+ * swallowed. Measured: setup printed, guest quiesced, `kill -USR1` did nothing.
+ *
+ * WHY A FLAG AND NOT THE WORK ITSELF: msync() on a 2.5GB mapping is not
+ * async-signal-safe, so the handler only records the request and a QEMU timer
+ * performs it from the main loop.
+ *
+ * DURABILITY vs CONSISTENCY, unchanged by P2-012 and still the thing that bites:
+ * the kernel writes dirty pages back on its own schedule (~30s,
+ * /proc/sys/vm/dirty_expire_centisecs), so data survives `kill -9` without any
+ * help. What msync buys is a KNOWN point, not durability that was otherwise
+ * absent. Neither gives a filesystem-consistent image: the guest may be
+ * mid-transaction, leaving a dirty LUFS journal whose replay is exactly the
+ * BAD TRAP in ufs:readlog/vfs_mountroot we keep hitting. For an image that
+ * boots, quiesce first:
+ *     guest:   sync; lockfs -f /
+ *     monitor: stop
+ *     host:    kill -USR2 <qemu>
+ *     monitor: cont
+ * tools/checkpoint.sh does that sequence. */
+static volatile sig_atomic_t niagara_sync_requested;
+
+static void niagara_sync_signal(int sig)
+{
+    (void)sig;
+    niagara_sync_requested = 1;
+}
+
+/* Polls the SIGUSR2 flag from the main loop, where doing real work is safe.
+ * Also supports an unattended periodic sync via NIAGARA_SYNC_SECS. */
+static QEMUTimer *niagara_sync_timer;
+static int64_t     niagara_sync_period_ms;
+
+/* Force dirty pages of the mapping out to the image file.
+ *
+ * This is the whole of what used to be a 2560MB copy: the guest's writes are
+ * already in the page cache, msync just makes the writeback point explicit and
+ * waits for it. MS_SYNC rather than MS_ASYNC because the caller wants a
+ * durability barrier they can rely on afterwards, which is the entire purpose. */
+static void niagara_vdisk_msync(const char *why)
+{
+    if (!niagara_vdisk_host || !niagara_vdisk_size) {
+        return;
+    }
+    if (msync(niagara_vdisk_host, niagara_vdisk_size, MS_SYNC) != 0) {
+        fprintf(stderr, "niagara: msync failed (%s): %s\n", why, strerror(errno));
+        return;
+    }
+    fprintf(stderr, "niagara: vdisk synced (%s)\n", why);
+}
+
+static void niagara_sync_tick(void *opaque)
+{
+    (void)opaque;
+    if (niagara_sync_requested) {
+        niagara_sync_requested = 0;
+        niagara_vdisk_msync("SIGUSR2");
+    } else if (niagara_sync_period_ms > 0) {
+        niagara_vdisk_msync("periodic");
+    }
+    timer_mod(niagara_sync_timer,
+              qemu_clock_get_ms(QEMU_CLOCK_REALTIME) +
+              (niagara_sync_period_ms > 0 ? niagara_sync_period_ms : 1000));
+}
+
+static void niagara_sync_setup(void)
+{
+    const char *env = getenv("NIAGARA_SYNC_SECS");
+
+    /* A signal rather than a new HMP command: no monitor plumbing, and it works
+     * from any shell. `kill -USR2 <qemu-pid>` forces a durability point. */
+    signal(SIGUSR2, niagara_sync_signal);
+
+    if (env && atoi(env) > 0) {
+        niagara_sync_period_ms = (int64_t)atoi(env) * 1000;
+        fprintf(stderr, "niagara: periodic vdisk msync every %s s\n", env);
+    }
+
+    /* Tick once a second even without a period so SIGUSR2 is picked up promptly. */
+    niagara_sync_timer = timer_new_ms(QEMU_CLOCK_REALTIME, niagara_sync_tick, NULL);
+    timer_mod(niagara_sync_timer,
+              qemu_clock_get_ms(QEMU_CLOCK_REALTIME) +
+              (niagara_sync_period_ms > 0 ? niagara_sync_period_ms : 1000));
+    fprintf(stderr, "niagara: msync on SIGUSR2 -> kill -USR2 %d\n", (int)getpid());
+}
