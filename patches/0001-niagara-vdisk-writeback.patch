@@ -84,6 +86,349 @@ typedef struct NiagaraBoardState {
 #define NIAGARA_OBP_OFFSET  0x80000ULL
 #define PROM_SIZE_MAX       (4 * MiB)
 
+/* vdisk: disk content loaded via reset handler, written back via atexit.
+ *
+ * At every machine reset, niagara_vdisk_load() reads the zvol directly into
+ * vdisk_ram in 64MB chunks — no ROM subsystem, no temp files, no INT_MAX
+ * overflow. VTOC slice-2 nblks (offset 0x1d0) is read to determine logical
+ * disk size; larger zvols work transparently.
+ *
+ * CRITICAL: run "lockfs -f / && sync" before exiting QEMU or the LUFS journal
+ * will be dirty and the next boot will panic at ufs:fetchbuf. */
+#define DISK_S2NBLK_OFFSET 0x1d0ULL
+
+static void   *niagara_vdisk_host;
+static size_t  niagara_vdisk_size;
+static char   *niagara_vdisk_path;
+
+/* Set only after a fully successful load. The writeback refuses to run
+ * unless this is true.
+ *
+ * Why this matters: a failed blk_pread used to be ignored, leaving that
+ * chunk of vdisk_ram as the zeros from the memset. The unconditional
+ * writeback then persisted those zeros over the real disk, and the next
+ * boot loaded the now-zeroed image — a self-reinforcing corruption loop
+ * that destroyed the zvol. Never write back a disk we did not fully read. */
+static bool    niagara_vdisk_load_ok;
+
+/* Set by the SIGUSR2 handler, acted on by a periodic timer.
+ *
+ * SIGUSR2, NOT SIGUSR1: QEMU defines SIG_IPI as SIGUSR1 on Linux and uses it to
+ * kick CPU threads, so a handler installed on SIGUSR1 is either overwritten or
+ * the signal is swallowed. Measured: the setup line printed, the guest quiesced,
+ * and `kill -USR1` produced no flush at all.
+ *
+ * WHY A CHECKPOINT FACILITY EXISTS AT ALL: the writeback below was originally
+ * reachable only from atexit, which made every session all-or-nothing. If the
+ * guest wedged -- and after a PPP session `init 5` reliably ends in a broken OBP
+ * rather than "Program terminated" -- the only safe move was to discard the
+ * whole session and roll back. Being able to flush on demand turns a session
+ * into something you can checkpoint.
+ *
+ * WHY A FLAG AND NOT THE WORK ITSELF: niagara_vdisk_writeback() calls
+ * fprintf, open, pwrite and system(). None of that is async-signal-safe, so the
+ * handler only records the request and a QEMU timer performs it from the main
+ * loop.
+ *
+ * CONSISTENCY CAVEAT, read before trusting a checkpoint: flushing a running
+ * guest yields a CRASH-consistent image, not a filesystem-consistent one. The
+ * guest may be mid-transaction, so its LUFS journal needs replay -- which is
+ * exactly the BAD TRAP in ufs:readlog/vfs_mountroot we keep hitting. For an
+ * image that actually boots, quiesce first:
+ *     guest:   sync; lockfs -f /
+ *     monitor: stop
+ *     host:    kill -USR1 <qemu>
+ *     monitor: cont
+ * tools/checkpoint.sh does that sequence. */
+static volatile sig_atomic_t niagara_sync_requested;
+
+static void niagara_sync_signal(int sig)
+{
+    (void)sig;
+    niagara_sync_requested = 1;
+}
+
+static void niagara_vdisk_load(void *opaque)
+{
+    BlockBackend *blk = (BlockBackend *)opaque;
+    uint8_t *ptr = (uint8_t *)niagara_vdisk_host;
+    int64_t  size = (int64_t)niagara_vdisk_size;
+    const int64_t CHUNK = 64LL * 1024 * 1024;
+    int64_t off = 0;
+
+    niagara_vdisk_load_ok = false;
+    if (!ptr || size <= 0) { return; }
+
+    memset(ptr, 0, size);
+    while (off < size) {
+        int64_t count = MIN(CHUNK, size - off);
+        int ret = blk_pread(blk, off, count, ptr + off, 0);
+        if (ret < 0) {
+            error_report("niagara: vdisk read failed at offset %lld (%s); "
+                         "refusing to run with a partially loaded disk",
+                         (long long)off, strerror(-ret));
+            exit(1);
+        }
+        off += count;
+    }
+    niagara_vdisk_load_ok = true;
+}
+
+/* final=true is the atexit path: take a safety snapshot and release the path.
+ * final=false is a checkpoint: flush only, and stay reusable. */
+static void niagara_vdisk_writeback_full(bool final)
+{
+    int fd;
+    int64_t off = 0, rem;
+    int r __attribute__((unused));
+    char cmd[512];
+
+    if (!niagara_vdisk_host || !niagara_vdisk_size || !niagara_vdisk_path)
+        return;
+
+    if (!niagara_vdisk_load_ok) {
+        fprintf(stderr, "niagara: vdisk never fully loaded — "
+                        "SKIPPING writeback to avoid corrupting %s\n",
+                niagara_vdisk_path);
+        return;
+    }
+
+    /* Only on the atexit path. A periodic checkpoint must not mint a snapshot
+     * every time or it buries the meaningful ones and eats the pool. */
+    if (final) {
+        const char *zvol_prefix = "/dev/zvol/";
+        if (strncmp(niagara_vdisk_path, zvol_prefix, strlen(zvol_prefix)) == 0) {
+            const char *ds = niagara_vdisk_path + strlen(zvol_prefix);
+            snprintf(cmd, sizeof(cmd),
+                     "zfs snapshot '%s@pre-exit-%d' 2>/dev/null", ds, (int)getpid());
+            r = system(cmd);
+        }
+    }
+
+    fprintf(stderr, "niagara: writeback -> %s (%lld MB)\n",
+            niagara_vdisk_path, (long long)(niagara_vdisk_size >> 20));
+
+    fd = open(niagara_vdisk_path, O_WRONLY);
+    if (fd < 0) { perror("niagara: vdisk writeback open"); return; }
+
+    rem = (int64_t)niagara_vdisk_size;
+    while (rem > 0) {
+        size_t chunk = (size_t)MIN(rem, 64LL * 1024 * 1024);
+        ssize_t n = pwrite(fd, (const char *)niagara_vdisk_host + off, chunk, off);
+        if (n < 0) {
+            fprintf(stderr, "niagara: pwrite failed at offset %lld: %s\n",
+                    (long long)off, strerror(errno));
+            break;
+        }
+        if (n == 0) {
+            fprintf(stderr, "niagara: pwrite returned 0 at offset %lld\n",
+                    (long long)off);
+            break;
+        }
+        off += n; rem -= n;
+    }
+    if (fdatasync(fd) < 0) {
+        fprintf(stderr, "niagara: fdatasync failed: %s\n", strerror(errno));
+    }
+    if (close(fd) < 0) {
+        fprintf(stderr, "niagara: close failed: %s\n", strerror(errno));
+    }
+    fprintf(stderr, "niagara: vdisk writeback complete (%lld MB)\n",
+            (long long)(off >> 20));
+    /* Freeing the path on a checkpoint would make every later call bail out at
+     * the !niagara_vdisk_path guard above, silently disabling checkpointing. */
+    if (final) {
+        g_free(niagara_vdisk_path);
+        niagara_vdisk_path = NULL;
+    }
+}
+
+/* atexit entrypoint: final flush, safety snapshot, release. */
+static void niagara_vdisk_writeback(void)
+{
+    niagara_vdisk_writeback_full(true);
+}
+
+/* Polls the SIGUSR1 flag from the main loop, where doing real work is safe.
+ * Also supports an unattended periodic flush via NIAGARA_SYNC_SECS. */
+static QEMUTimer *niagara_sync_timer;
+static int64_t     niagara_sync_period_ms;
+
+static void niagara_sync_tick(void *opaque)
+{
+    (void)opaque;
+    if (niagara_sync_requested) {
+        niagara_sync_requested = 0;
+        fprintf(stderr, "niagara: checkpoint requested (SIGUSR2)\n");
+        niagara_vdisk_writeback_full(false);
+    } else if (niagara_sync_period_ms > 0) {
+        fprintf(stderr, "niagara: periodic checkpoint\n");
+        niagara_vdisk_writeback_full(false);
+    }
+    timer_mod(niagara_sync_timer,
+              qemu_clock_get_ms(QEMU_CLOCK_REALTIME) +
+              (niagara_sync_period_ms > 0 ? niagara_sync_period_ms : 1000));
+}
+
+static void niagara_sync_setup(void)
+{
+    const char *env = getenv("NIAGARA_SYNC_SECS");
+
+    /* SIGUSR1 rather than a new HMP command: no monitor plumbing, and it works
+     * from any shell. `kill -USR1 <qemu-pid>` flushes the vdisk to the zvol. */
+    signal(SIGUSR2, niagara_sync_signal);
+
+    if (env && atoi(env) > 0) {
+        niagara_sync_period_ms = (int64_t)atoi(env) * 1000;
+        fprintf(stderr, "niagara: periodic vdisk checkpoint every %s s\n", env);
+    }
+
+    /* Tick once a second even without a period so SIGUSR1 is picked up promptly. */
+    niagara_sync_timer = timer_new_ms(QEMU_CLOCK_REALTIME, niagara_sync_tick, NULL);
+    timer_mod(niagara_sync_timer,
+              qemu_clock_get_ms(QEMU_CLOCK_REALTIME) +
+              (niagara_sync_period_ms > 0 ? niagara_sync_period_ms : 1000));
+    fprintf(stderr, "niagara: checkpoint on SIGUSR2 -> kill -USR2 %d\n", (int)getpid());
+}
+
+/* ---- P2-014: bidirectional host<->guest channel ------------------------
+ *
+ * A region at the tail of vdisk slice 3 that lies outside any filesystem:
+ * the FAT on s3 was deliberately rebuilt at 496MB inside its 512MB slice,
+ * leaving the last 16MB free by construction. See CURRENT-STATE.md.
+ *
+ * WHY THIS NEEDS NO LOCK, MAILBOX, SIGNAL OR MONITOR: the region is split
+ * into halves with exactly ONE writer each. The host writes the h2g half and
+ * only ever reads the g2h half; the guest does the reverse. So this timer can
+ * unconditionally pull one direction in and push the other out with no
+ * possibility of a lost update. That single observation is what collapses the
+ * whole synchronisation problem -- an earlier design had a control block, a
+ * request opcode and a completion counter, none of which are necessary.
+ *
+ * The guest reaches the same bytes via /dev/rdsk/c0t0d0s3 at the matching
+ * offset, which is a proven path (hsimd, hypercalls 0xf0/0xf1) needing no new
+ * guest driver. Raw writes there MUST be whole 512-byte blocks.
+ *
+ * Off unless NIAGARA_CHAN=1, so existing behaviour and tests are unchanged.
+ *
+ * This is deliberately the crude version: it moves both halves every tick
+ * regardless of whether anything changed. At the measured ~700MB/s marginal
+ * writeback rate, 1MB/tick costs ~1.5ms against a 20ms tick. Scaling to 16
+ * channels wants a header-first pass that only moves data for channels whose
+ * sequence number advanced; that optimisation is not needed to prove the path.
+ */
+/* Derived, never hardcoded: an earlier version of this used a literal
+ * 2668003328 copied from a note, which was 832 blocks too high. It happened to
+ * remain inside the free region so nothing broke, which is exactly why it would
+ * have survived to confuse someone later. Keep the arithmetic visible. */
+#define NIAGARA_S3_START_BLK  4194304LL   /* VTOC slice 3 start, absolute */
+#define NIAGARA_S3_FAT_NBLK   1015808LL   /* pcfs made 496MB inside a 512MB slice */
+#define NIAGARA_S3_NBLK       1048576LL   /* the slice itself, 512MB */
+
+#define NIAGARA_CHAN_BASE \
+    ((NIAGARA_S3_START_BLK + NIAGARA_S3_FAT_NBLK) * 512LL)   /* 2667577344 */
+#define NIAGARA_CHAN_ROOM \
+    ((NIAGARA_S3_NBLK - NIAGARA_S3_FAT_NBLK) * 512LL)        /* 16MB */
+#define NIAGARA_CHAN_HALF  (512LL * 1024)
+
+static QEMUTimer *niagara_chan_timer;
+static int64_t    niagara_chan_ms = 20;
+static int        niagara_chan_rfd = -1;
+static int        niagara_chan_wfd = -1;
+static bool       niagara_chan_complained;
+
+/* Loop until the whole range moves: pread/pwrite may transfer short. */
+static bool niagara_chan_xfer(int fd, uint8_t *mem, int64_t off, int64_t len,
+                              bool writing)
+{
+    int64_t done = 0;
+
+    while (done < len) {
+        ssize_t n = writing
+            ? pwrite(fd, mem + done, (size_t)(len - done), (off_t)(off + done))
+            : pread(fd,  mem + done, (size_t)(len - done), (off_t)(off + done));
+        if (n <= 0) {
+            if (n < 0 && errno == EINTR) { continue; }
+            return false;
+        }
+        done += n;
+    }
+    return true;
+}
+
+static void niagara_chan_tick(void *opaque)
+{
+    uint8_t *ram = (uint8_t *)niagara_vdisk_host;
+    bool ok = true;
+
+    (void)opaque;
+
+    /* Never touch RAM we did not fully load, for the same reason the writeback
+     * refuses to: we would publish memset zeros over real disk contents. */
+    if (ram && niagara_vdisk_load_ok &&
+        NIAGARA_CHAN_BASE + 2 * NIAGARA_CHAN_HALF <= (int64_t)niagara_vdisk_size) {
+
+        /* host -> guest: pull the host-written half into guest-visible RAM */
+        if (niagara_chan_rfd >= 0) {
+            ok &= niagara_chan_xfer(niagara_chan_rfd, ram + NIAGARA_CHAN_BASE,
+                                    NIAGARA_CHAN_BASE, NIAGARA_CHAN_HALF, false);
+        }
+        /* guest -> host: push the guest-written half out to the zvol */
+        if (niagara_chan_wfd >= 0) {
+            ok &= niagara_chan_xfer(niagara_chan_wfd,
+                                    ram + NIAGARA_CHAN_BASE + NIAGARA_CHAN_HALF,
+                                    NIAGARA_CHAN_BASE + NIAGARA_CHAN_HALF,
+                                    NIAGARA_CHAN_HALF, true);
+        }
+        /* Report once, not every 20ms. */
+        if (!ok && !niagara_chan_complained) {
+            niagara_chan_complained = true;
+            fprintf(stderr, "niagara: channel sync failed: %s\n", strerror(errno));
+        }
+    }
+
+    timer_mod(niagara_chan_timer,
+              qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + niagara_chan_ms);
+}
+
+static void niagara_chan_setup(void)
+{
+    const char *env = getenv("NIAGARA_CHAN");
+    const char *ms  = getenv("NIAGARA_CHAN_MS");
+
+    if (!env || atoi(env) != 1) { return; }
+    if (!niagara_vdisk_path) {
+        fprintf(stderr, "niagara: NIAGARA_CHAN=1 but no vdisk path; channel off\n");
+        return;
+    }
+    if (ms && atoi(ms) > 0) { niagara_chan_ms = atoi(ms); }
+
+    /* Refuse rather than silently corrupt the filesystem next door. Both halves
+     * must fit in the space the shrunken FAT left behind. */
+    if (2 * NIAGARA_CHAN_HALF > NIAGARA_CHAN_ROOM) {
+        fprintf(stderr, "niagara: channel needs %lldKB but only %lldKB is free "
+                        "past the FAT; channel off\n",
+                (long long)((2 * NIAGARA_CHAN_HALF) >> 10),
+                (long long)(NIAGARA_CHAN_ROOM >> 10));
+        return;
+    }
+
+    /* Separate fds per direction so a read-only failure cannot disable writes. */
+    niagara_chan_rfd = open(niagara_vdisk_path, O_RDONLY);
+    if (niagara_chan_rfd < 0) { perror("niagara: channel open (read)"); }
+    niagara_chan_wfd = open(niagara_vdisk_path, O_WRONLY);
+    if (niagara_chan_wfd < 0) { perror("niagara: channel open (write)"); }
+
+    if (niagara_chan_rfd < 0 && niagara_chan_wfd < 0) { return; }
+
+    niagara_chan_timer = timer_new_ms(QEMU_CLOCK_REALTIME, niagara_chan_tick, NULL);
+    timer_mod(niagara_chan_timer,
+              qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + niagara_chan_ms);
+    fprintf(stderr, "niagara: channel at byte %lld, 2x%lldKB halves, %lldms tick\n",
+            (long long)NIAGARA_CHAN_BASE, (long long)(NIAGARA_CHAN_HALF >> 10),
+            (long long)niagara_chan_ms);
+}
