+     * later triggers a cache flush that corrupts in-flight SPARC64 translations.
+     */
+#define NIAGARA_FLATBLK_FILE "/datapool/niagara/flatblk.raw"
+    {
+        struct stat flatblk_st;
+        if (stat(NIAGARA_FLATBLK_FILE, &flatblk_st) == 0 && flatblk_st.st_size > 0) {
+            Error *flatblk_err = NULL;
+            memory_region_init_ram_from_file(&s->flatblk_ram, NULL,
+                                             "sun4v_flatblk.ram",
+                                             flatblk_st.st_size,
+                                             0, RAM_SHARED,
+                                             NIAGARA_FLATBLK_FILE,
+                                             0, &flatblk_err);
+            if (flatblk_err) {
+                error_free(flatblk_err);
+                memory_region_init_ram(&s->flatblk_ram, NULL,
+                                       "sun4v_flatblk.ram",
