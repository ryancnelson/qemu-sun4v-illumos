+                niagara_flatblk_host = memory_region_get_ram_ptr(&s->flatblk_ram);
+                niagara_flatblk_size = flatblk_st.st_size;
+                niagara_flatblk_path = g_strdup(NIAGARA_FLATBLK_FILE);
+                atexit(niagara_flatblk_writeback);
+                fprintf(stderr, "niagara: flatblk at 0x%lx via atexit\n",
+                        (unsigned long)NIAGARA_FLATBLK_BASE);
+            } else {
+                fprintf(stderr, "niagara: flatblk at 0x%lx via MAP_SHARED\n",
+                        (unsigned long)NIAGARA_FLATBLK_BASE);
+            }
+            memory_region_add_subregion(sysmem, NIAGARA_FLATBLK_BASE,
