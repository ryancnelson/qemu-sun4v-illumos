@@ -84,6 +87,74 @@ typedef struct NiagaraBoardState {
 #define NIAGARA_OBP_OFFSET  0x80000ULL
 #define PROM_SIZE_MAX       (4 * MiB)
 
+/* vdisk write-back state — written once in niagara_init, read in atexit */
+static void   *niagara_vdisk_host;
+static size_t  niagara_vdisk_size;
+static char   *niagara_vdisk_path;
+
+/* flatblk write-back — guest writes directly to this RAM via CPU stores,
+ * bypassing q.bin/LDC entirely. atexit captures exactly what the guest wrote. */
+static void   *niagara_flatblk_host;
+static size_t  niagara_flatblk_size;
+static char   *niagara_flatblk_path;
+
+static void __attribute__((unused)) niagara_flatblk_writeback(void)
+{
+    int fd;
+    ssize_t n;
+
+    if (!niagara_flatblk_host || !niagara_flatblk_size || !niagara_flatblk_path) {
+        return;
+    }
+
+    fd = open(niagara_flatblk_path, O_WRONLY);
+    if (fd < 0) {
+        perror("niagara: flatblk writeback open");
+        return;
+    }
+
+    n = pwrite(fd, niagara_flatblk_host, niagara_flatblk_size, 0);
+    if (n != (ssize_t)niagara_flatblk_size) {
+        fprintf(stderr, "niagara: flatblk writeback: wrote %zd of %zu bytes\n",
+                n, niagara_flatblk_size);
+    }
+    fdatasync(fd);
+    close(fd);
+
+    g_free(niagara_flatblk_path);
+    niagara_flatblk_path = NULL;
+}
+
+static void niagara_vdisk_writeback(void)
+{
+    int fd;
+    ssize_t n;
+
+    if (!niagara_vdisk_host || !niagara_vdisk_size || !niagara_vdisk_path) {
+        return;
+    }
+
+    fd = open(niagara_vdisk_path, O_WRONLY);
+    if (fd < 0) {
+        perror("niagara: vdisk writeback open");
+        return;
+    }
+
+    n = pwrite(fd, niagara_vdisk_host, niagara_vdisk_size, 0);
+    if (n != (ssize_t)niagara_vdisk_size) {
+        fprintf(stderr, "niagara: vdisk writeback: wrote %zd of %zu bytes\n",
+                n, niagara_vdisk_size);
+    }
+
+    if (fdatasync(fd) < 0) {
+        perror("niagara: vdisk writeback fdatasync");
+    }
+    close(fd);
+
+    g_free(niagara_vdisk_path);
+    niagara_vdisk_path = NULL;
+}
+
 static void add_rom_or_fail(const char *file, const hwaddr addr)
 {
     /* XXX remove qtest_enabled() check once firmware files are
@@ -102,6 +173,42 @@ static void niagara_init(MachineState *machine)
