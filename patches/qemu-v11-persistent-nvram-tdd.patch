+                    base_machine, filename);
+    g_assert_cmphex(qtest_readb(s, base + NVRAM_CANARY_OFFSET), ==, 0x5a);
+    qtest_quit(s);
+
+    g_assert_cmpint(g_remove(filename), ==, 0);
+}
+
+static size_t nvram_find(const uint8_t *image, const char *value)
+{
+    size_t value_len = strlen(value);
+    size_t i;
+
+    for (i = 0; i + value_len <= NVRAM_SIZE; i++) {
+        if (memcmp(image + i, value, value_len) == 0) {
+            return i;
+        }
+    }
+    return NVRAM_SIZE;
+}
+
+static bool nvram_contains(const uint8_t *image, const char *value)
+{
+    return nvram_find(image, value) != NVRAM_SIZE;
+}
+
+static void nvram_preserves_persistent_environment(void)
+{
+    g_autoptr(GError) error = NULL;
+    g_autofree char *filename = NULL;
+    g_autofree uint8_t *image = g_malloc(NVRAM_SIZE);
+    QTestState *s;
+    int fd;
+
+    filename = g_strdup_printf("%s/m48t59-test-XXXXXX", g_get_tmp_dir());
+    fd = g_mkstemp(filename);
+    g_assert_cmpint(fd, >=, 0);
+    close(fd);
+
+    s = qtest_initf("-M %s -rtc clock=vm -prom-env auto-boot?=true",
+                    base_machine);
+    qtest_memread(s, base, image, NVRAM_SIZE);
+    qtest_quit(s);
+    g_assert_true(nvram_contains(image, "auto-boot?=true"));
+    g_assert_true(g_file_set_contents(filename, (char *)image,
+                                      NVRAM_SIZE, &error));
+
+    s = qtest_initf("-M %s -rtc clock=vm "
+                    "-global sysbus-m48t08.filename=%s "
+                    "-prom-env auto-boot?=false",
+                    base_machine, filename);
+    qtest_memread(s, base, image, NVRAM_SIZE);
+    qtest_quit(s);
+
+    g_assert_true(nvram_contains(image, "auto-boot?=true"));
+    g_assert_false(nvram_contains(image, "auto-boot?=false"));
+    g_assert_cmpint(g_remove(filename), ==, 0);
+}
+
+static void nvram_creates_missing_image(void)
+{
+    g_autoptr(GError) error = NULL;
+    g_autofree char *contents = NULL;
