 void m48t59_realize_common(M48t59State *s, Error **errp)
 {
+    g_autofree char *contents = NULL;
+    g_autoptr(GError) gerror = NULL;
+    bool create = false;
+    gsize length;
+
     s->buffer = g_malloc0(s->size);
+    s->fd = -1;
+    if (s->filename) {
+        if (!g_file_get_contents(s->filename, &contents, &length, &gerror)) {
+            if (!g_error_matches(gerror, G_FILE_ERROR, G_FILE_ERROR_NOENT)) {
+                error_setg(errp, "cannot read M48TXX NVRAM image %s: %s",
+                           s->filename, gerror->message);
+                return;
+            }
+            create = true;
+            g_clear_error(&gerror);
+        } else if (length != s->size) {
+            error_setg(errp, "M48TXX NVRAM image %s must be exactly %u bytes",
+                       s->filename, s->size);
+            return;
+        } else {
+            memcpy(s->buffer, contents, length);
+        }
+        s->fd = qemu_open_old(s->filename,
+                              O_RDWR | (create ? O_CREAT | O_EXCL : 0), 0600);
+        if (s->fd < 0) {
+            error_setg_errno(errp, errno, "cannot open M48TXX NVRAM image %s",
+                             s->filename);
+            return;
+        }
+        if (create && ftruncate(s->fd, s->size) < 0) {
+            int saved_errno = errno;
+
+            close(s->fd);
+            s->fd = -1;
+            unlink(s->filename);
+            error_setg_errno(errp, saved_errno,
+                             "cannot size M48TXX NVRAM image %s",
+                             s->filename);
+            return;
+        }
+        s->persistent_image_loaded = !create;
+    }
     if (s->model == 59) {
         s->alrm_timer = timer_new_ns(rtc_clock, &alarm_cb, s);
