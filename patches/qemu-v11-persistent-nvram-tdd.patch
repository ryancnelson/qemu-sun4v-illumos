+static void nvram_preserves_legacy_image(void)
+{
+    g_autoptr(GError) error = NULL;
+    g_autofree uint8_t *expected = NULL;
+    g_autofree char *filename = NULL;
+    g_autofree uint8_t *image = g_malloc(NVRAM_SIZE);
+    size_t free_header;
+    size_t free_name;
+    QTestState *s;
+    int fd;
+
+    filename = g_strdup_printf("%s/m48t59-test-XXXXXX", g_get_tmp_dir());
+    fd = g_mkstemp(filename);
+    g_assert_cmpint(fd, >=, 0);
+    close(fd);
+
+    s = qtest_initf("-M %s -rtc clock=vm "
+                    "-prom-env diag-switch?=false "
+                    "-prom-env auto-boot?=true "
+                    "-prom-env boot-device=disk",
+                    base_machine);
+    qtest_memread(s, base, image, NVRAM_SIZE);
+    qtest_quit(s);
+
+    free_name = nvram_find(image, "free");
+    g_assert_cmpuint(free_name, ==, 84);
+    free_header = free_name - 4;
+
+    /* Reproduce the header bytes in the historical QEMU 7.x image. */
+    image[0] = 0x74;
+    image[1] = 0;
+    image[2] = 0;
+    image[3] = 0;
+    image[free_header] = 0;
+    image[free_header + 1] = 0;
+    expected = g_memdup2(image, NVRAM_SIZE);
+    g_assert_true(g_file_set_contents(filename, (char *)image,
+                                      NVRAM_SIZE, &error));
+
+    s = qtest_initf("-M %s -rtc clock=vm "
+                    "-global sysbus-m48t08.filename=%s "
+                    "-prom-env auto-boot?=false "
+                    "-prom-env boot-device=disk0 "
+                    "-prom-env input-device=ttya "
+                    "-prom-env output-device=ttya",
+                    base_machine, filename);
+    qtest_memread(s, base, image, NVRAM_SIZE);
+    qtest_quit(s);
+
+    g_assert_cmpmem(image, 0x1fd0, expected, 0x1fd0);
+    g_assert_cmpint(g_remove(filename), ==, 0);
+}
