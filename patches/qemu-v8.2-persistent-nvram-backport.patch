diff --git a/hw/rtc/m48t59-internal.h b/hw/rtc/m48t59-internal.h
--- a/hw/rtc/m48t59-internal.h
+++ b/hw/rtc/m48t59-internal.h
@@ -53,6 +53,9 @@ typedef struct M48t59State {
     QEMUTimer *wd_timer;
     /* NVRAM storage */
     uint8_t *buffer;
+    char *filename;
+    FILE *file;
+    bool persistent_image_loaded;
     /* Model parameters */
     uint32_t model; /* 2 = m48t02, 8 = m48t08, 59 = m48t59 */
     /* NVRAM storage */
diff --git a/include/hw/rtc/m48t59.h b/include/hw/rtc/m48t59.h
--- a/include/hw/rtc/m48t59.h
+++ b/include/hw/rtc/m48t59.h
@@ -45,6 +45,7 @@ struct NvramClass {
     uint32_t (*read)(Nvram *obj, uint32_t addr);
     void (*write)(Nvram *obj, uint32_t addr, uint32_t val);
     void (*toggle_lock)(Nvram *obj, int lock);
